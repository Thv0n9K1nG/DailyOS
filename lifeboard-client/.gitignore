# =============================================================
#  LifeBoard Frontend — .gitignore (lifeboard-client/)
#  Scoped to the React + Vite workspace
# =============================================================

# ── Dependencies ──────────────────────────────────────────────
node_modules/
.pnpm-store/
.yarn/

# ── Build outputs ─────────────────────────────────────────────
dist/
dist-ssr/
.vite/

# ── Environment / Secrets ─────────────────────────────────────
# .env.local contains VITE_API_BASE_URL — keep .env.example committed
.env.local
.env.*.local
.env.production
.env.staging

# ── Logs ──────────────────────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.log

# ── Test artifacts ────────────────────────────────────────────
playwright-report/
test-results/
playwright/.cache/
coverage/

# ── Cache ─────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache

# ── Misc ──────────────────────────────────────────────────────
*.local
*.sw?
