# =============================================================
#  LifeBoard Backend — .dockerignore (LifeBoard.API/)
#  Applied when: docker build context = ./LifeBoard.API
#  Goal: exclude build artifacts, secrets, dev-only files
# =============================================================

# ── Build artifacts (rebuilt inside Docker) ───────────────────
bin/
obj/
out/
publish/

# ── Logs (written at runtime, not baked into image) ──────────
logs/
*.log

# ── Secrets & Local config ───────────────────────────────────
# NEVER commit or bake these — inject via Docker env vars
appsettings.Production.json
appsettings.Staging.json
*.Development.json
.env
*.secret

# ── Test projects & results ──────────────────────────────────
**/*.Tests/
TestResults/
coverage/
*.trx
*.coveragexml

# ── IDE & Dev tools ──────────────────────────────────────────
.vscode/
.idea/
*.user
*.suo
*.sln.docstates
.DotSettings.user
.vs/

# ── Git ──────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── NuGet local cache (restored inside Docker) ───────────────
**/packages/
!**/packages/build/
*.nupkg
*.snupkg

# ── Docs & Non-essential ─────────────────────────────────────
*.md
LICENSE

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~
*.swp
*.swo
