# =============================================================
#  LifeBoard Root — .dockerignore
#  Applied when docker build context = repo root (.)
#  E.g.: docker build -f LifeBoard.API/Dockerfile .
# =============================================================

# ── Frontend build artifacts ──────────────────────────────────
lifeboard-client/node_modules/
lifeboard-client/dist/
lifeboard-client/.vite/

# ── Backend build artifacts ───────────────────────────────────
LifeBoard.API/bin/
LifeBoard.API/obj/
LifeBoard.API/out/
LifeBoard.API/logs/

# ── Secrets & Environment ─────────────────────────────────────
.env
.env.local
.env.*.local
lifeboard-client/.env.local
LifeBoard.API/appsettings.Production.json
LifeBoard.API/appsettings.Staging.json

# ── Test artifacts ────────────────────────────────────────────
**/TestResults/
**/playwright-report/
**/test-results/
**/coverage/

# ── IDE & Editor ─────────────────────────────────────────────
.vscode/
.idea/
*.user
*.suo
*.sw?
.vs/

# ── Git ──────────────────────────────────────────────────────
.git/
.gitignore
.gitattributes

# ── Docs (large markdown files not needed in image) ──────────
docs/

# ── OS ───────────────────────────────────────────────────────
.DS_Store
Thumbs.db
*~

# ── Logs & Cache ─────────────────────────────────────────────
*.log
.cache/
